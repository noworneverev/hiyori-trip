rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTrip(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.destination is string && data.destination.size() <= 200 &&
             data.startDate is string && data.startDate.size() <= 30 &&
             data.endDate is string && data.endDate.size() <= 30 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.days is list && data.days.size() <= 30;
    }

    function isValidSharedTrip(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.destination is string && data.destination.size() <= 200 &&
             data.startDate is string && data.startDate.size() <= 30 &&
             data.endDate is string && data.endDate.size() <= 30 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.days is list && data.days.size() <= 30;
    }

    // User Private Trips Collection
    match /users/{userId}/trips/{tripId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(tripId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(tripId) &&
                       incoming().ownerId == request.auth.uid &&
                       isValidTrip(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(tripId) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       isValidTrip(incoming());
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(tripId) &&
                       existing().ownerId == request.auth.uid;
    }

    // Public Shared Trips Collection (Anyone with link can read, no listing to prevent harvesting)
    match /shared_trips/{shareId} {
      allow get: if isValidId(shareId);
      allow list: if false;
      allow create: if isValidId(shareId) && isValidSharedTrip(incoming());
      allow update: if isValidId(shareId) && (
                      (isSignedIn() && existing().ownerId == request.auth.uid) ||
                      (!isSignedIn() && existing().ownerId == 'guest')
                    ) && isValidSharedTrip(incoming());
      allow delete: if isValidId(shareId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Collaborative Trips Collection (Multiplayer real-time co-editing)
    match /collab_trips/{collabId} {
      allow get: if isValidId(collabId);
      allow list: if false;
      allow create: if isValidId(collabId) && isValidSharedTrip(incoming());
      allow update: if isValidId(collabId) && isValidSharedTrip(incoming());
      allow delete: if isValidId(collabId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
